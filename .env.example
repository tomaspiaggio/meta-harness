# Optional overrides; copy to .env (loaded by pnpm dev/start).
# HARNESS_DATA_DIR=/absolute/path/to/meta-harness-data
# HARNESS_CONCURRENCY=1
# HARNESS_POLL_MS=1000
# HARNESS_TURN_TIMEOUT_MS=1800000
# PORT=3000
# CODEX_BIN=codex
# CLAUDE_BIN=claude
# HARNESS_BIND_HOST=127.0.0.1
# HARNESS_RUN_WORKER=1
# HARNESS_REQUIRE_AUTH=0
# Owner Google login (local Pi/SQLite supported; no hosted flag needed):
# HARNESS_AUTH=google
# HARNESS_PUBLIC_URL=https://harness.yourdomain.com
# HARNESS_OWNER_EMAILS=your-verified-google-email@gmail.com
# GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-web-client-secret
# BETTER_AUTH_SECRET=32-or-more-random-characters-generated-locally
# Callback: https://harness.yourdomain.com/api/auth/callback/google
# Leave HARNESS_AUTH unset until Google credentials and the origin are configured.
# HARNESS_CONTROL_URL=https://your-control-plane
# HARNESS_WORKER_TOKEN_FILE=/secure/path/worker.json
# HARNESS_WORKER_DATA_DIR=/absolute/path/worker-cache
# HARNESS_MEMORY_BUDGET_MIB=2048
# HARNESS_MEMORY_RESERVE_MIB=1024
# HARNESS_CPU_SLOTS=2
# HARNESS_BUILD_SLOTS=1
# HARNESS_BROWSER_SLOTS=1
# HARNESS_MAX_LOAD_PER_CPU=1.5
# HARNESS_PROVIDERS=demo,claude,codex
# Settings stores global defaults; sessions can override their model.
# Optional worker fallbacks when the selected model is "Provider default":
# HARNESS_CLAUDE_MODEL=haiku
# HARNESS_CODEX_MODEL=gpt-6.1-sol
# Experimental Claude Agent SDK transcript mirroring:
# HARNESS_CLAUDE_RUNTIME=sdk
# HARNESS_CLAUDE_MAX_BUDGET_USD=0.1
# HARNESS_CLAUDE_TOOLS=none

# PostgreSQL is optional locally. Supabase can host it; no Supabase SDK is used.
# DATABASE_URL=postgresql://user:password@host:5432/meta_harness?sslmode=verify-full
# DIRECT_URL=postgresql://migration-user:password@direct-host:5432/meta_harness?sslmode=verify-full
# HARNESS_TIMEZONE=America/Los_Angeles
# HARNESS_IDLE_POLL_MS=5000

# Hosted control plane: owner OIDC authentication is mandatory and fails closed.
# HARNESS_HOSTED=1
# HARNESS_PUBLIC_URL=https://harness.example.com
# HARNESS_OIDC_ISSUER=https://your-identity-provider
# HARNESS_OIDC_CLIENT_ID=your-client-id
# HARNESS_OIDC_CLIENT_SECRET=your-client-secret-if-required
# HARNESS_OWNER_SUBJECTS=stable-oidc-subject
# HARNESS_OWNER_EMAILS=verified-owner@example.com
# Generate separate random 32-byte keys; store/recover them outside DB/object backups.
# HARNESS_GRANT_KEY=base64url-encoded-32-byte-key
# HARNESS_ENCRYPTION_KEY=base64-encoded-32-byte-key
# CRON_SECRET=at-least-32-random-characters

# Private S3-compatible object storage; omit for local filesystem objects.
# HARNESS_S3_BUCKET=private-harness-objects
# HARNESS_S3_REGION=us-east-1
# HARNESS_S3_ENDPOINT=https://your-s3-compatible-service
# HARNESS_S3_PATH_STYLE=1
# HARNESS_S3_ACCESS_KEY_ID=restricted-bucket-key
# HARNESS_S3_SECRET_ACCESS_KEY=restricted-bucket-secret

# Browser access is automatic. Mac + installed Chrome defaults to the paired extension.
# Install apps/browser-extension/dist once and run pnpm browser:pair on its host.
# Uses existing logins in dedicated background tabs; never exports personal cookies.
# Linux/other hosts default to managed Chromium started on demand.
# Choose managed explicitly for isolated profiles or test stacks.
# HARNESS_BROWSER_BACKEND=extension
# HARNESS_BROWSER_EXTENSION_PORT=46121
# HARNESS_BROWSER_EXTENSION_CONFIG=/restricted/path/to/browser-extension.json
# Optional directory containing Chrome's DevToolsActivePort (not a profile copy):
# HARNESS_CHROME_USER_DATA_DIR=/absolute/path/to/Google/Chrome
# pnpm browser:install uses only this harness's cache.
# Optional host-level override for machines that should never host browsers:
# HARNESS_BROWSER_ENABLED=1
# HARNESS_BROWSER_CACHE_DIR=/absolute/path/to/browser-cache
# HARNESS_BROWSER_IDLE_MS=120000
# Headless by default, including macOS. Set 0 only for an explicitly visible host.
# HARNESS_BROWSER_HEADLESS=1
# HARNESS_BROWSER_EXECUTABLE=/absolute/path/to/compatible-chromium
# Optional local Claude extension integration; authenticate/validate separately.
# HARNESS_CLAUDE_CHROME=1
# API-only bare mode is opt-in; it does not use a subscription login.
# HARNESS_CLAUDE_BARE=1

# Secrets backend: names in policies map only to JOB_SECRET_* variables here.
# HARNESS_SECRET_BINDINGS={"crm-token":"JOB_SECRET_CRM","claude-api":"JOB_SECRET_CLAUDE"}
# JOB_SECRET_CRM=your-secret-value
# JOB_SECRET_CLAUDE=your-separately-billed-api-key
# Linux dedicated container supervisor only; never run the Mac worker as root.
# HARNESS_ISOLATE_AGENTS=1

# Optional utility title generation; explicit API billing, no agent process.
# Without this configuration titles use a bounded local heuristic.
# HARNESS_TITLE_API_URL=https://your-openai-compatible-service/v1/chat/completions
# HARNESS_TITLE_MODEL=your-cheapest-suitable-model-id
# HARNESS_TITLE_API_KEY=your-utility-only-key

# Optional Telegram via the official Chat SDK adapter; requires PostgreSQL.
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_WEBHOOK_SECRET=at-least-32-random-url-safe-characters
# TELEGRAM_ALLOWED_USER_IDS=your-numeric-telegram-user-id
# TELEGRAM_CHAT_ID=your-private-chat-or-controlled-forum-group-id
# TELEGRAM_AUTO_TOPICS=1

# Optional Sandbox: disabled unless both deployment and workspace opt in.
# HARNESS_SANDBOX_ENABLED=1
# HARNESS_SANDBOX_SNAPSHOT_ID=validated-worker-snapshot
# HARNESS_SANDBOX_WORKER_PATH=/vercel/sandbox/meta-harness/apps/worker
# HARNESS_SANDBOX_MAX_CONCURRENT=1
# HARNESS_SANDBOX_MAX_STARTS_PER_DAY=4
# HARNESS_SANDBOX_TIMEOUT_MS=900000
# HARNESS_SANDBOX_VCPUS=1
# VERCEL_TOKEN=your-sandbox-capacity-manager-token
# VERCEL_TEAM_ID=your-team-id
# VERCEL_PROJECT_ID=your-project-id
