# Optional overrides; copy to .env (loaded by pnpm dev/start).
# HARNESS_DATA_DIR=/absolute/path/to/meta-harness-data
# HARNESS_CONCURRENCY=1
# HARNESS_POLL_MS=1000
# HARNESS_TURN_TIMEOUT_MS=1800000
# PORT=3000
# CODEX_BIN=codex
# CLAUDE_BIN=claude
# HARNESS_BIND_HOST=127.0.0.1
# HARNESS_RUN_WORKER=1
# HARNESS_REQUIRE_AUTH=0
# HARNESS_CONTROL_URL=https://your-control-plane
# HARNESS_WORKER_TOKEN_FILE=/secure/path/worker.json
# HARNESS_WORKER_DATA_DIR=/absolute/path/worker-cache
# HARNESS_MEMORY_BUDGET_MIB=2048
# HARNESS_MEMORY_RESERVE_MIB=1024
# HARNESS_CPU_SLOTS=2
# HARNESS_BUILD_SLOTS=1
# HARNESS_BROWSER_SLOTS=1
# HARNESS_MAX_LOAD_PER_CPU=1.5
# HARNESS_PROVIDERS=demo,claude,codex
# Experimental Claude Agent SDK transcript mirroring:
# HARNESS_CLAUDE_RUNTIME=sdk
# HARNESS_CLAUDE_MODEL=haiku
# HARNESS_CLAUDE_MAX_BUDGET_USD=0.1
# HARNESS_CLAUDE_TOOLS=none
