{
  "name": "meta-harness",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @harness/web dev",
    "dev:worker": "pnpm --filter @harness/worker dev",
    "build": "turbo run build --concurrency=1",
    "start": "node scripts/dev.mjs --production",
    "check": "biome check . && node scripts/check-boundaries.mjs && turbo run typecheck --concurrency=1",
    "format": "biome check --write .",
    "test": "tsx --test --test-concurrency=1 packages/*/src/*.test.ts scripts/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "workflow": "node scripts/workflow.mjs",
    "test:restart": "node scripts/restart-smoke.mjs",
    "bench": "node --import tsx scripts/bench.mjs",
    "worker": "node scripts/worker.mjs",
    "worker:enroll": "node --import tsx scripts/enroll-worker.mjs",
    "start:control": "node scripts/dev.mjs --production --control-only",
    "bench:claude": "node --import tsx scripts/claude-bench.mjs",
    "test:security": "node scripts/security-smoke.mjs",
    "bench:knowledge": "node scripts/knowledge-bench.mjs",
    "db:generate": "pnpm --filter @harness/storage generate",
    "db:migrate": "pnpm --filter @harness/storage migrate",
    "postinstall": "pnpm db:generate",
    "browser:install": "node scripts/install-browser.mjs",
    "db:transfer": "node --import tsx scripts/database-transfer.mjs",
    "test:isolation": "node scripts/isolation-smoke.mjs",
    "smoke:features": "node scripts/features-smoke.mjs",
    "smoke:ui": "node scripts/ui-smoke.mjs",
    "sandbox:prepare": "node scripts/prepare-sandbox.mjs",
    "smoke:payloads": "node --import tsx scripts/payload-smoke.mjs",
    "smoke:deletion": "node scripts/deletion-smoke.mjs",
    "smoke:dev-refresh": "node scripts/dev-refresh-smoke.mjs",
    "smoke:dev-idle": "node scripts/dev-idle-smoke.mjs",
    "smoke:pdf": "node scripts/pdf-upload-smoke.mjs",
    "smoke:models": "node scripts/models-smoke.mjs",
    "smoke:native-tools": "node scripts/native-tools-smoke.mjs",
    "browser:pair": "node --import tsx scripts/pair-browser.mjs",
    "smoke:google": "node --import tsx scripts/google-smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
