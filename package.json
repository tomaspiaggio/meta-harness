{
  "name": "meta-harness",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @harness/web dev",
    "dev:worker": "pnpm --filter @harness/worker dev",
    "build": "turbo run build --concurrency=1",
    "start": "node scripts/dev.mjs --production",
    "check": "biome check . && node scripts/check-boundaries.mjs && turbo run typecheck --concurrency=1",
    "format": "biome check --write .",
    "test": "tsx --test --test-concurrency=1 packages/*/src/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "workflow": "node scripts/workflow.mjs",
    "test:restart": "node scripts/restart-smoke.mjs",
    "bench": "node --import tsx scripts/bench.mjs",
    "worker": "node scripts/worker.mjs",
    "worker:enroll": "node --import tsx scripts/enroll-worker.mjs",
    "start:control": "node scripts/dev.mjs --production --control-only"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
