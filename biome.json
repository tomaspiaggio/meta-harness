{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/node_modules",
      "!**/.turbo",
      "!**/.data",
      "!**/.workflow-data",
      "!**/app/.well-known",
      "!**/next-env.d.ts",
      "!**/pnpm-lock.yaml",
      "!**/generated",
      "!apps/browser-extension/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/components/ui/**", "apps/web/hooks/**"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["packages/browser/src/vendor/**"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    }
  ]
}
