{
  "manifest_version": 3,
  "name": "Meta Harness Browser",
  "version": "0.1.0",
  "description": "Connect this browser's signed-in accounts to your paired Meta Harness worker.",
  "minimum_chrome_version": "120",
  "permissions": ["debugger", "tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "Meta Harness browser connection" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
