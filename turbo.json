{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "app/.well-known/workflow/**",
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "HARNESS_*",
    "WORKFLOW_*",
    "CODEX_BIN",
    "CLAUDE_BIN",
    "PORT",
    "NEXT_TELEMETRY_DISABLED",
    "DATABASE_URL",
    "DIRECT_URL",
    "VERCEL_*",
    "TELEGRAM_*",
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "AI_GATEWAY_API_KEY",
    "AGENT_BROWSER_EXECUTABLE_PATH"
  ]
}
